{
	"name": "sjis-tools",
	"version": "1.0.0",
	"description": "CLI for safely editing SJIS/CP932 files — designed for AI agents",
	"type": "module",
	"bin": {
		"sjist": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun scripts/build.ts",
		"prepare": "bun run build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"knip": "knip",
		"check:quality": "quality-check",
		"pretest": "bun run build",
		"test": "bun test"
	},
	"keywords": [
		"sjis",
		"cp932",
		"shift-jis",
		"encoding",
		"binary",
		"replace",
		"ai-agent"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yuu1111/sjis-tools.git"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"iconv-lite": "^0.7.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.5",
		"@yuu1111/biome-config": "^2.2.2",
		"@yuu1111/knip-config": "^2.1.0",
		"@yuu1111/quality-check": "^5.3.1",
		"@yuu1111/tsconfig": "^1.0.8",
		"esbuild": "^0.28.2",
		"knip": "^6.41.0",
		"typescript": "^7.0.2"
	}
}
