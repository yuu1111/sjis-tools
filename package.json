{
	"name": "sjis-tools",
	"version": "1.0.0",
	"description": "CLI for safely editing SJIS/CP932 files — designed for AI agents",
	"type": "module",
	"bin": {
		"sjist": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun scripts/build.ts",
		"prepare": "bun run build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"pretest": "bun run build",
		"test": "bun test"
	},
	"keywords": [
		"sjis",
		"cp932",
		"shift-jis",
		"encoding",
		"binary",
		"replace",
		"ai-agent"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yuu1111/sjis-tools.git"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"iconv-lite": "^0.7.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@yuu1111/biome-config": "^1.0.3",
		"@types/bun": "^1.3.14",
		"@yuu1111/tsconfig": "^1.0.4",
		"esbuild": "^0.27.4",
		"typescript": "^5.9.3"
	}
}
