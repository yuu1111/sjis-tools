{
	"name": "sjis-tools",
	"version": "0.1.0",
	"description": "CLI & library for safely editing SJIS/CP932 files — designed for AI agents",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"bin": {
		"sjis-replace": "./dist/cli/sjis-replace.js",
		"sjis-create": "./dist/cli/sjis-create.js",
		"sjis-delete-lines": "./dist/cli/sjis-delete-lines.js",
		"sjis-extract-lines": "./dist/cli/sjis-extract-lines.js",
		"sjis-encoding-check": "./dist/cli/sjis-encoding-check.js",
		"sjis-encoding-repair": "./dist/cli/sjis-encoding-repair.js"
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc",
		"check": "biome check --write --unsafe ."
	},
	"keywords": ["sjis", "cp932", "shift-jis", "encoding", "binary", "replace", "ai-agent"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yuu1111/sjis-tools.git"
	},
	"dependencies": {
		"iconv-lite": "^0.7.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@yuu1111/biome-config": "^1.0.3",
		"@yuu1111/tsconfig": "^1.0.2",
		"bun-types": "^1.3.11",
		"typescript": "^5.9.3"
	}
}
